# Lager-appen, hvor lager-API'et bor (serveren tilføjer /api/lager). Skal være https://,
# undtagen mod loopback eller en vært i LAGER_INTERNAL_HOSTS.
LAGER_BASE_URL=https://app.example.com
# Kommaseparerede værtsnavne, der må nås over http:// (fx backendens containernavn på et
# internt Docker-netværk: LAGER_BASE_URL=http://lager-backend:3000). Eksakt match, ingen wildcards.
LAGER_INTERNAL_HOSTS=
# Internt token: samme værdi som LAGER_API_TOKEN i lager-appens konfiguration
LAGER_API_TOKEN=
# Brugeren, kaldene sker på vegne af. Bag gatewayen læses den fra X-MCP-User
# (LAGER_TRUST_FORWARDED_USER=true); ved stdio/dev sættes den her.
# HTTP-transporten nægter at starte uden LAGER_TRUST_FORWARDED_USER=true og MCP_HTTP_TOKEN.
LAGER_TRUST_FORWARDED_USER=false
LAGER_DEFAULT_USER=
# Skrivende tools (tjek ud, aflever, flyt, bestil, forbrug, booking, optælling, stamdata m.m.) kræver præcis "true".
LAGER_ENABLE_WRITES=false
LAGER_AUDIT_LOG=
LAGER_TIMEOUT_MS=30000
# Nye forsøg: skrivninger kun ved 429 og forbindelsesfejl før afsendelse; GET også ved en proxys 502/503/504
LAGER_RETRY_MAX=3
# Længste Retry-After, serveren venter på; et længere gives videre som fejl
LAGER_RETRY_MAX_VENT_MS=20000
# Samlet frist for nye forsøg pr. tool-kald
LAGER_RETRY_FRIST_MS=25000
# Hvor længe installationens moduler (fra /me) caches, i millisekunder
LAGER_MODULER_TTL_MS=300000
# HTTP-transporten
MCP_HTTP_HOST=127.0.0.1
PORT=3000
# Bearer, gatewayen sender (samme som UPSTREAM_TOKEN). Påkrævet i HTTP-mode.
MCP_HTTP_TOKEN=
# Det forrige token under en rotation: gælder samtidig med MCP_HTTP_TOKEN, til gatewayen er skiftet
MCP_HTTP_TOKEN_FORRIGE=
# Hemmeligheden bag Idempotency-Keys (HMAC), mindst 32 tegn, ens på alle instanser. Påkrævet i HTTP-mode.
MCP_IDEMPOTENS_HEMMELIGHED=
