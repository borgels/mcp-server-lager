# bcc, hvor lager-API'et bor (serveren tilføjer /api/lager)
LAGER_BASE_URL=https://bcc.borgels.com
# Internt token: samme værdi som LAGER_API_TOKEN i bcc's tilbudsmotor.env
LAGER_API_TOKEN=
# Brugeren, kaldene sker på vegne af. Bag gatewayen læses den fra X-MCP-User
# (LAGER_TRUST_FORWARDED_USER=true); ved stdio/dev sættes den her.
LAGER_TRUST_FORWARDED_USER=false
LAGER_DEFAULT_USER=
# Skrivende tools (tjek ud, aflever, flyt, bestil, forbrug, modtag levering) kræver præcis "true".
LAGER_ENABLE_WRITES=false
LAGER_AUDIT_LOG=
LAGER_TIMEOUT_MS=30000
# HTTP-transporten
MCP_HTTP_HOST=127.0.0.1
PORT=3000
# Bearer, gatewayen sender (samme som UPSTREAM_TOKEN)
MCP_HTTP_TOKEN=
